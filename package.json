{
  "name": "eazyflutter",
  "displayName": "Eazy Flutter",
  "description": "A VS Code extension that enhances Flutter development with quick actions and snippets.",
  "author": {
    "name": "Anand Krishna",
    "email": "anandevu2@gmail.com"
  },
  "publisher": "Krishak15",
  "icon": "images/icon.png",
  "version": "1.1.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.97.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Krishak15/eazyflutter-vscode-extension"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "EazyFlutter Configuration",
      "properties": {
        "eazyflutter.localizationKeyPrefix": {
          "type": "string",
          "default": "",
          "description": "Prefix to use before localization key when replacing in code (e.g. Applocalization.locale. or Localizations.locale.)"
        },
        "eazyflutter.autoL10nGenerate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run 'flutter gen-l10n' or 'fvm flutter gen-l10n' after updating .arb files."
        }
      }
    },
    "commands": [
      {
        "command": "consumerWrapper.wrapWithConsumer",
        "title": "EzFlutter: Wrap with Consumer<T>"
      },
      {
        "command": "extension.jsonToDart",
        "title": "EazyFlutter: JSON to Dart"
      },
      {
        "command": "eazyflutter.newDartFile",
        "title": "EazyFlutter: New Dart File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "eazyflutter.newDartFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ]
    },
    "snippets": [
      {
        "language": "dart",
        "path": "./snippets/dart-snippets.json"
      }
    ],
    "codeActions": [
      {
        "language": "dart",
        "title": "Wrap with Consumer<T>",
        "command": "consumerWrapper.wrapWithConsumer"
      }
    ],
    "keybindings": [
      {
        "command": "eazyflutter.newDartFile",
        "key": "Ctrl+K Ctrl+N",
        "mac": "Cmd+K Cmd+N",
        "when": "explorerViewletFocus"
      }
    ],
    "languages": [
      {
        "id": "dart",
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node16 --external:vscode --minify --outfile=dist/extension.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.3"
  },
  "dependencies": {
    "quicktype-core": "^26.0.0",
    "remove": "^0.1.5",
    "uninstall": "^0.0.0"
  }
}